---
import Layout from '../components/layout.astro';
---

<style>
  h2 {
    text-align: center;
  }

  .project-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .project-list li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--lightBorder);
  }

  .project-list li:last-child {
    border-bottom: none;
  }
</style>

<Layout
  title="Portfolio"
  description="A list of placeholder projects for the portfolio."
>
  <main>
    <h2>Portfolio</h2>
    <ul class="project-list">
      <li>
        <h3>Project One</h3>
        <p>A placeholder project description. Link to a live demo or repo here.</p>
      </li>
      <li>
        <h3>Project Two</h3>
        <p>A placeholder project description. Link to a live demo or repo here.</p>
      </li>
      <li>
        <h3>Project Three</h3>
        <p>A placeholder project description. Link to a live demo or repo here.</p>
      </li>
    </ul>
  </main>
</Layout>
